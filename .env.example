# Copy to .env and fill in. Never commit real values.

# --- Authentication, stdio mode (local npx / MCPB) ---
# Personal API token (ClickUp avatar > Settings > Apps > API Token, starts with pk_).
# Optional when an OAuth app or a saved OAuth token is used instead.
CLICKUP_API_KEY=
# Workspace id. Optional when the token is authorized for exactly one workspace.
# In hosted mode it is also the workspace gate: only users who authorized this workspace may connect.
CLICKUP_TEAM_ID=

# --- ClickUp OAuth app (stdio login via `auth`, and required in hosted mode) ---
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# stdio only: local callback port (redirect URL http://localhost:8787/callback). Default 8787.
# CLICKUP_OAUTH_PORT=8787
# stdio only: where the OAuth token is saved. Default ~/.config/clickup-mcp/token.json
# CLICKUP_TOKEN_FILE=

# --- Both modes ---
# read-minimal | read | write (default)
# CLICKUP_MCP_MODE=write
# MAX_IMAGES=4
# MAX_RESPONSE_SIZE_MB=1
# MAX_UPLOAD_SIZE_MB=10
# CLICKUP_COMMENT_EDIT_WINDOW_HOURS=24
# CLICKUP_PRIMARY_LANGUAGE=en

# --- Hosted mode only (node dist/http.js, npm run start:http) ---
# Required. At least 32 characters, e.g. `openssl rand -hex 32`. Never auto-generated.
# Rotating it logs every user out.
MCP_TOKEN_SECRET=
# Required. External origin of this server, e.g. https://clickup-mcp.example.com
# On Railway it falls back to https://$RAILWAY_PUBLIC_DOMAIN when unset.
MCP_PUBLIC_URL=
# Listen port. Default 3000.
# PORT=3000
# Access token lifetime in seconds. Default 3600.
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# Refresh token lifetime in seconds. Default 30 days (2592000).
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
# Idle time before an MCP session is dropped, in seconds. Default 3600.
# MCP_SESSION_IDLE_SECONDS=3600
# Extra redirect URI schemes for native MCP clients (comma-separated, e.g. cursor). Default: https only, plus http://localhost.
# MCP_ALLOWED_REDIRECT_SCHEMES=
